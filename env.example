# ---- Server ----
PORT=4000
NODE_ENV=development
APP_NAME=MeatMarket Srikakulam

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://username:password@localhost:5432/meat_delivery
DB_SSL=false

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---- OTP Provider ----
# Plug in your own SMS/Email OTP provider credentials here.
# The code calls sendOtpViaProvider() in src/utils/otp.js - implement that
# function's HTTP call to your provider (e.g. MSG91, Twilio Verify, 2Factor, etc).
OTP_PROVIDER_NAME=msg91
OTP_PROVIDER_API_KEY=
OTP_PROVIDER_SENDER_ID=
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ---- WhatsApp Business Cloud API ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0

# ---- File storage (private, for delivery-partner documents) ----
# STORAGE_DRIVER=local uses the local ./uploads/private folder (dev only).
# For production, point this at private S3/GCS-compatible object storage
# and implement the upload in src/middleware/upload.js accordingly.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads/private
MAX_UPLOAD_MB=5

# ---- Platform business rules ----
DELIVERY_BASE_CHARGE=0
TAX_PERCENT=0
DELIVERY_PARTNER_EARNING_PER_ORDER=0
